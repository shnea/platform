          "Files"
        ],
        "security": [
          {
            "ServerApiKey": []
          }
        ],
        "x-required-scope": "files:write",
        "responses": {
          "200": {
            "description": "성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Upload"
                }
              }
            }
          },
          "default": {
            "description": "한국어 오류. code/requestId로 처리합니다.",
