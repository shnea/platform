            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8388608
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
