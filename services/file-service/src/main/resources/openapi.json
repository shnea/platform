  "components": {
    "securitySchemes": {
      "ServerApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Platform-Key"
      },
      "Administrator": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "관리자 realm 발급, audience platform-admin-api, platform-admin 역할 필요"
      }
    },
    "schemas": {
      "UploadCreate": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "originalName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000000000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "PRIVATE"
            ],
            "default": "PUBLIC"
          },
          "retentionCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "default": "default"
          }
        },
        "required": [
          "requestId",
          "originalName",
          "size",
          "sha256"
        ]
      },
      "Upload": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "UPLOADING",
              "READY",
              "CANCELLED",
              "EXPIRED",
              "DELETED"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000000000
          },
          "receivedBytes": {
            "type": "integer",
            "minimum": 0
          },
          "maxChunkBytes": {
            "type": "integer",
            "const": 8388608
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "fileId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "uploadId",
          "state",
          "size",
          "receivedBytes",
          "maxChunkBytes",
          "expiresAt",
          "fileId"
        ]
      },
      "FileInfo": {
        "type": "object",
        "properties": {
          "fileId": {
            "type": "string",
            "format": "uuid"
          },
          "originalName": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000000000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "PRIVATE"
            ]
          },
          "retentionCode": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastUsedAt": {
            "type": "string",
            "format": "date-time"
          },
          "downloadUrl": {
            "type": "string"
          }
        },
        "required": [
          "fileId",
          "originalName",
          "size",
          "sha256",
          "visibility",
          "retentionCode",
          "createdAt",
          "lastUsedAt",
          "downloadUrl"
        ]
      },
      "Visibility": {
        "type": "object",
        "properties": {
          "visibility": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "PRIVATE"
            ]
          }
        },
        "required": [
          "visibility"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "code": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "requestId"
        ]
      },
      "Resumable": {
        "type": "object",
        "properties": {
          "upload": {
            "$ref": "#/components/schemas/Upload"
          },
          "originalName": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "PRIVATE"
            ]
          },
          "retentionCode": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "upload",
          "originalName",
          "sha256",
          "visibility",
          "retentionCode",
          "requestId"
        ]
      },
      "DownloadTicket": {
        "type": "object",
        "properties": {
          "downloadUrl": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "downloadUrl",
          "expiresAt"
        ]
      }
    }
  }
}
