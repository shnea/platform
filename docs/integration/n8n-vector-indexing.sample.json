    {
      "id": "a910bf6c-9e1f-474f-8bf2-d88803456d55",
      "name": "키의 프로젝트·환경 조회",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.PLATFORM_URL.replace(/\\/$/, '') + '/api/v1/integration/context' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 100000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "retryOnFail": false,
      "onError": "stopWorkflow"
    },
    {
      "id": "80a55fd0-8987-4a1c-90dc-e5ffa86cb4a5",
      "name": "범위와 문서 준비",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const scope = $input.first().json;\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/;\nif (!uuid.test(scope.projectId) || !uuid.test(scope.environmentId)) throw new Error('키의 프로젝트·환경 정보를 확인하세요.');\nconst logical = 'document_sample';\nconst collection = `platform_${scope.projectId.replace(/-/g,'')}_${scope.environmentId.replace(/-/g,'')}_${logical}`;\nconst documents = [{title:'공통 인덱싱 검수', content:'서버 키의 프로젝트와 환경별로 문서를 격리합니다.'}];\nreturn documents.map(d => ({json:{collection,text:d.content,metadata:{title:d.title,project:scope.projectId,environment:scope.environmentId,collection,embedding_model:'models/gemini-embedding-001'}}}));"
      }
    },
    {
      "id": "35d1129e-3e11-41ec-8a97-791146ca854b",
      "name": "Qdrant 컬렉션 차원 확인",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.QDRANT_URL.replace(/\\/$/, '') + '/collections/' + $json.collection }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 100000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "retryOnFail": false,
      "onError": "stopWorkflow"
    },
    {
      "id": "465b3195-9c65-4ee9-a599-6c73789dd561",
      "name": "컬렉션 검증·문서 복원",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const result = $input.first().json.result;\nconst vectors = result?.config?.params?.vectors;\n// Native Gemini node currently does not set outputDimensionality. Pre-create a new 3072/Cosine collection.\nif (vectors?.size !== 3072 || vectors?.distance !== 'Cosine') throw new Error('검색·인덱싱의 모델과 3072/Cosine 컬렉션을 맞추세요. 기존 벡터를 섞지 않습니다.');\nreturn $('범위와 문서 준비').all();"
      }
    },
    {
      "id": "9dba0663-61aa-4401-8e4e-3285387e95ee",
      "name": "문서 한 건씩",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
