      "id": "d670c5f0-b880-4a8d-9b05-6ce608873b6e",
      "name": "Qdrant 문서 저장",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.1,
      "position": [
        1340,
        120
      ],
