{
  "name": "@shnea/editor",
  "version": "0.1.0-alpha.4",
  "private": true,
  "type": "module",
  "description": "SHNEA 공통 에디터의 문서 계약과 편집 코어",
  "files": [
    "dist",
    "README.md",
    "src/styles/editor.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/editing/ui.d.ts",
      "import": "./dist/editing/ui.js"
    },
    "./style.css": "./src/styles/editor.css",
    "./image-viewer": {
      "types": "./dist/viewer/image-viewer.d.ts",
      "import": "./dist/viewer/image-viewer.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "markdown-it": "15.0.2"
  },
  "devDependencies": {
    "jsdom": "30.1.1",
    "typescript": "7.0.2"
  }
}
