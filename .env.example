COMPOSE_PROJECT_NAME=shnea-platform-dev
IMAGE_TAG=0.1.0-dev
BIND_ADDRESS=127.0.0.1
HTTP_PORT=30140
# 실제 직전 프록시 IP/CIDR 하나. 30140 접근을 프록시로 제한한 뒤 변경합니다.
# Docker Desktop의 NAT 주소를 지정할 때는 호스트 방화벽 제한이 필수입니다.
NGINX_TRUSTED_PROXY=127.0.0.1
DB_PORT=30141
# 운영: https://platform.shnea.kr/auth (TLS 배포 구성 후 적용)
KEYCLOAK_PUBLIC_URL=http://localhost:30140/auth
KEYCLOAK_ADMIN=admin
# Generate local values with scripts/init-env.py. Never commit the real .env.
POSTGRES_PASSWORD=
PROJECT_DB_PASSWORD=
FILE_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
IDENTITY_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
PLATFORM_MODE=dev
# false이면 새 Job 실행/복구만 중지합니다. 기존 동기 API는 유지합니다.
PLATFORM_JOBS_ENABLED=true
PLATFORM_EVENTS_ENABLED=true
PLATFORM_EVENTS_SECRET=
# 서비스 지표 내부 조회 전용. 메일·이벤트 키와 분리합니다.
PLATFORM_MONITORING_SECRET=
# 공통 소셜 앱 자격증명. Keycloak만 읽으며 실제 .env는 Git에 올리지 않습니다.
# 카카오 CLIENT_ID는 REST API 키입니다. DEV에서는 실제 로그인을 호출하지 않습니다.
SOCIAL_NAVER_CLIENT_ID=
SOCIAL_NAVER_CLIENT_SECRET=
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_KAKAO_CLIENT_ID=
SOCIAL_KAKAO_CLIENT_SECRET=
# 인증 이메일: dev/DEV는 모의 수신함, prod/PROD는 NCP 발송.
PLATFORM_MAIL_SECRET=
NCP_ACCESS_KEY=
NCP_SECRET_KEY=
NCP_SMS_SERVICE_ID=
NCP_BIZ_MESSAGE_SERVICE_ID=
NCP_MAIL_API_ENDPOINT=https://mail.apigw.ntruss.com
NCP_MAIL_API_PATH=/api/v1/mails
NCP_MAIL_SENDER_ADDRESS=
NCP_MAIL_SENDER_NAME=SHNEA
NCP_SMS_SENDER_NUMBER=
NCP_KAKAO_CHANNEL_ID=
# 명시적인 운영자 발송 검사 전용. 일반 Compose 기동으로 발송하지 않습니다.
NCP_TEST_EMAIL=
NCP_TEST_PHONE=
PLATFORM_ADMIN_PASSWORD=
KEYCLOAK_PROVISIONER_SECRET=
# Change resource limits, then run compose up -d to recreate containers.
DB_MEMORY=512m
DB_CPUS=1.0
KEYCLOAK_MEMORY=1024m
KEYCLOAK_CPUS=2.0
PROJECT_MEMORY=512m
PROJECT_CPUS=1.0
FILE_MEMORY=512m
FILE_CPUS=1.0
NOTIFICATION_MEMORY=512m
NOTIFICATION_CPUS=1.0
NGINX_MEMORY=64m
NGINX_CPUS=0.5
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError

# 관리자 화면의 정확한 origin. 운영은 HTTPS, 변경 후 identity-setup 재실행.
# 운영: https://platform.shnea.kr
PLATFORM_WEB_URL=http://localhost:30140
ADMIN_WEB_MEMORY=64m
ADMIN_WEB_CPUS=0.5
